  "narrative": {
    "northStar": "KeepMind companions at work",
    "overview": "Preserve the incumbent KeepMind K mark and black/lime identity while using the upstream component kit. The workspace is a legible, compact working environment for objectives, execution, approvals and evidence. Brand accents identify action without replacing the semantic meaning of status, access controls or provider identities.\n\nThe approved abstract companion family extends the existing operating UI rather than redesigning whole pages. Kivo, Luma, Nexo and Faro add matte charcoal bodies and expressive faces; recognizing work states takes priority over decoration. The original K mark, black/lime identity and Onest typography remain unchanged.",
    "keyCharacteristics": [
      "Original K mark and KeepMind OS wordmark.",
      "Warm white light surfaces and charcoal dark surfaces.",
      "Lime primary actions with black labels; theme-specific agent text.",
      "Existing responsive controls, keyboard focus and semantic states.",
      "Original abstract companions with live expressions and preserved user appearances."
    ],
    "rules": [
      {
        "name": "The Semantic Accent Rule",
        "body": "Use action tokens for primary actions and agent tokens for agent emphasis; retain the separate meaning of warning, danger and provider identity.",
        "section": "colors"
      },
      {
        "name": "The Work-State Rule",
        "body": "Preserve readable state, expression, accessible naming and user appearance when using companion artwork; the family never replaces status text, evidence or permission controls.",
        "section": "components"
      }
    ],
    "dos": [
      "Do retain the original K mark and semantic action tokens.",
      "Do reuse the local companion atlas and shared live renderer for agent identity.",
      "Do preserve custom agent names, saved eye styles, accessories and reduced-motion behavior.",
      "Do preserve capabilities, evidence, approvals and permission boundaries when simplifying a surface.",
      "Do use the final CSS cascade and mirrored tokens when adding screens.",
      "Do retain required upstream attribution in About."
    ],
    "donts": [
      "Do not use lime as light-theme body text.",
      "Do not recolor errors, warnings or provider brands as generic brand accents.",
      "Do not turn documentation or static inspection into a claim of usability validation.",
      "Do not infer deployed or native-packaged status from this design record."
    ]
  }
}
