# Generate both with openssl rand -hex 32. Never commit .env.
POSTGRES_PASSWORD=
AGENTES_SECRET=
# SHA-256 of a separately generated first-owner claim token. Required before public exposure.
OWNER_CLAIM_SHA256=
# Optional daily database backup (docker compose --profile backup): an S3-compatible bucket and its credentials.
# S3_BACKUP_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Jev (optional, recommended): the small judge that picks which agent answers a message nobody @mentioned and
# which tools each answer loads. Without it the server asks a small model on the workspace's own key, which is
# slower and paid by that key. A key from https://console.typesafe.ai/keys, or add it later in Settings › AI accounts.
# TYPESAFE_API_KEY=
# Company sign-in (SSO, ADR 0188): your identity provider's OpenID Connect issuer and the app registered there,
# with the redirect URI https://keepmind.io/api/auth/callback/sso. SSO_REQUIRED=true needs SSO_DOMAINS.
# SSO_OIDC_ISSUER=
# SSO_OIDC_CLIENT_ID=
# SSO_OIDC_CLIENT_SECRET=
# SSO_NAME=
# SSO_DOMAINS=
# SSO_REQUIRED=false
# SSO_WORKSPACE_ID=
# The company's directory (SCIM, ADR 0189): the SHA-256 of the token you give it.
# SCIM_TOKEN_SHA256=
