{
  "name": "@keepmind/server",
  "version": "0.2.0-alpha.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "bun --env-file=../../.env --watch src/main.ts",
    "start": "bun --env-file=../../.env src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist --sourcemap=linked"
  },
  "dependencies": {
    "@keepmind/adapters": "workspace:*",
    "@keepmind/client": "workspace:*",
    "@keepmind/config": "workspace:*",
    "@keepmind/db": "workspace:*",
    "@keepmind/engine": "workspace:*",
    "@keepmind/i18n": "workspace:*",
    "@keepmind/modules": "workspace:*",
    "@keepmind/providers": "workspace:*",
    "@keepmind/setup": "workspace:*",
    "@keepmind/tokens": "workspace:*",
    "@better-auth/expo": "^1.7.7",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.9",
    "better-auth": "^1.7.7",
    "hono": "^4.13.13",
    "zod": "^4.6.5",
    "@keepmind/ui": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "license": "AGPL-3.0-only"
}
