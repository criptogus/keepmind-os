{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeepMind OS",
  "version": "0.2.0-alpha.4",
  "identifier": "io.keepmind.teams",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "popover",
        "url": "index.html",
        "title": "KeepMind OS",
        "width": 380,
        "height": 520,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "welcome",
        "create": false,
        "url": "index.html",
        "title": "KeepMind OS",
        "width": 720,
        "height": 600,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "center": true
      },
      {
        "label": "prefs",
        "create": false,
        "url": "index.html",
        "title": "KeepMind OS",
        "width": 860,
        "height": 600,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["agenteschat"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "KeepMind OS \u2014 Teams and AI agents",
    "copyright": "Copyright \u00a9 2026 Codari Global, LLC",
    "license": "AGPL-3.0-only",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/agentes-runner", "binaries/agent-browser"],
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE": "NOTICE",
      "licenses/agent-browser/*": "licenses/agent-browser/",
      "licenses/bun/*": "licenses/bun/"
    },
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  }
}
