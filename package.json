{
  "name": "zero-agency-os",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.11.0"
  },
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "vite build && esbuild src/main/main.ts --bundle --platform=node --format=cjs --packages=external --supported:dynamic-import=true --outfile=dist/main/main.cjs && esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main/preload.cjs && cp build/tray-icon.png dist/main/tray-icon.png",
    "dev": "vite --host 127.0.0.1 --port 0",
    "start": "electron .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "typecheck": "tsc --noEmit",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "dist:mac": "npm run build && electron-builder --mac",
    "astryx": "astryx",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "runner": "esbuild src/runner/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/runner/cli.mjs && node dist/runner/cli.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@composio/core": "0.28.0",
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@tanstack/react-query": "^5.62.0",
    "@whiskeysockets/baileys": "6.7.24",
    "electron-updater": "6.8.11",
    "jszip": "3.10.1",
    "open-bot-avatar": "0.2.0",
    "openai": "^4.73.0",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "unpdf": "1.4.0",
    "uuid": "^11.0.3",
    "xlsx": "0.18.5",
    "zod": "^3.25",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5",
    "electron": "45.2.3",
    "electron-builder": "^26",
    "esbuild": "0.28.2",
    "typescript": "~5.9.3",
    "unplugin": "2.3.11",
    "vite": "^7",
    "vitest": "^3"
  },
  "build": {
    "appId": "com.keepmind.os",
    "productName": "KeepMind OS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@whiskeysockets/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "icon": "build/icon.icns",
    "protocols": [
      {
        "name": "KeepMind OS",
        "schemes": [
          "keepmind"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "criptogus",
        "repo": "keepmind-os"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "description": "KeepMind OS \u2014 local agent workspace",
  "author": "KeepMind",
  "repository": {
    "type": "git",
    "url": "https://github.com/criptogus/keepmind-os.git"
  }
}
